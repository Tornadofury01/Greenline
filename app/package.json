    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.1",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.27",
    "lucide-react": "^1.72.0",
    "motion": "^14.14.0",
    "p5": "^1.11.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "recharts": "^3.10.1",
    "vanta": "^0.5.24"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "daisyui": "^5.8.1",
    "tailwindcss": "^4.3.5",
