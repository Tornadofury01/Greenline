{
  "_note": "PLACEHOLDERS for the five model slots. Same values for every field. Used only when shared/v2/models/<field-id>.json is missing (or lacks that section). Every value here is a rough, rounded stand-in written for plugging models in later, NOT a measurement and NOT verified. Edit or replace here; scoring/modelSlots.js reads nothing else.",
  "version": 1,
  "verified": false,
  "tag": "placeholder",

  "modelA": {
    "_note": "Fixed typical calendar per crop (Texas Blackland Prairie, rounded). Days are day-of-year (1-365). plantYearOffset -1 = planted the previous autumn. rangeDays = +/- spread. Crop per year is NOT here: the slot takes it straight from the field file's cropHistory (USDA Cropland Data Layer). Crops not in this table (e.g. 'other') get no calendar.",
    "cropYearSource": "usda-cdl",
    "calendars": {
      "winter_wheat":       { "plantYearOffset": -1, "plantDoy": 293, "greenUpDoy": 46,  "peakDoy": 115, "endDoy": 161, "endKind": "harvest",   "rangeDays": 10 },
      "corn":               { "plantYearOffset": 0,  "plantDoy": 79,  "greenUpDoy": 95,  "peakDoy": 152, "endDoy": 217, "endKind": "harvest",   "rangeDays": 10 },
      "grain_sorghum":      { "plantYearOffset": 0,  "plantDoy": 100, "greenUpDoy": 115, "peakDoy": 182, "endDoy": 232, "endKind": "harvest",   "rangeDays": 12 },
      "cotton":             { "plantYearOffset": 0,  "plantDoy": 115, "greenUpDoy": 130, "peakDoy": 213, "endDoy": 283, "endKind": "harvest",   "rangeDays": 12 },
      "soybeans":           { "plantYearOffset": 0,  "plantDoy": 125, "greenUpDoy": 140, "peakDoy": 206, "endDoy": 274, "endKind": "harvest",   "rangeDays": 12 },
      "sunflower":          { "plantYearOffset": 0,  "plantDoy": 95,  "greenUpDoy": 110, "peakDoy": 166, "endDoy": 217, "endKind": "harvest",   "rangeDays": 12 },
      "sesame":             { "plantYearOffset": 0,  "plantDoy": 152, "greenUpDoy": 165, "peakDoy": 217, "endDoy": 268, "endKind": "harvest",   "rangeDays": 12 },
      "alfalfa":            { "plantYearOffset": -1, "plantDoy": 274, "greenUpDoy": 60,  "peakDoy": 135, "endDoy": 330, "endKind": "harvest",   "rangeDays": 15, "perennial": true },
      "cowpea":             { "plantYearOffset": 0,  "plantDoy": 171, "greenUpDoy": 180, "peakDoy": 232, "endDoy": 263, "endKind": "terminate", "rangeDays": 10 },
      "sorghum_sudangrass": { "plantYearOffset": 0,  "plantDoy": 152, "greenUpDoy": 165, "peakDoy": 213, "endDoy": 258, "endKind": "terminate", "rangeDays": 10 },
      "cereal_rye":         { "plantYearOffset": -1, "plantDoy": 288, "greenUpDoy": 32,  "peakDoy": 105, "endDoy": 115, "endKind": "terminate", "rangeDays": 10 },
      "crimson_clover":     { "plantYearOffset": -1, "plantDoy": 283, "greenUpDoy": 45,  "peakDoy": 100, "endDoy": 115, "endKind": "terminate", "rangeDays": 10 },
      "hairy_vetch":        { "plantYearOffset": -1, "plantDoy": 283, "greenUpDoy": 50,  "peakDoy": 105, "endDoy": 115, "endKind": "terminate", "rangeDays": 10 }
    },
    "cropConfidence": null,
    "cropConfidenceNote": "USDA labels carry no per-year probability in the placeholder, so confidence is null (unknown), never 1.0."
  },

  "modelB": {
    "_note": "One fixed sensitivity per crop, same for every field. droughtKy = yield-response factor (FAO-33 style: 1.0 = yield falls as fast as water supply; higher = more drought-sensitive). Values for crops FAO-33 does not list are guesses. heatLossPerDay = share of yield lost per day above heatThresholdC during the sensitive stage (0.01 = 1 %). heatThresholdC = daily max temperature that starts hurting.",
    "crops": {
      "winter_wheat":       { "droughtKy": 1.0,  "heatLossPerDay": 0.010, "heatThresholdC": 32 },
      "corn":               { "droughtKy": 1.25, "heatLossPerDay": 0.015, "heatThresholdC": 35 },
      "grain_sorghum":      { "droughtKy": 0.9,  "heatLossPerDay": 0.006, "heatThresholdC": 37 },
      "cotton":             { "droughtKy": 0.85, "heatLossPerDay": 0.008, "heatThresholdC": 36 },
      "soybeans":           { "droughtKy": 0.85, "heatLossPerDay": 0.008, "heatThresholdC": 35 },
      "sunflower":          { "droughtKy": 0.95, "heatLossPerDay": 0.006, "heatThresholdC": 37 },
      "sesame":             { "droughtKy": 0.6,  "heatLossPerDay": 0.003, "heatThresholdC": 38 },
      "alfalfa":            { "droughtKy": 1.1,  "heatLossPerDay": 0.005, "heatThresholdC": 37 },
      "cowpea":             { "droughtKy": 0.7,  "heatLossPerDay": 0.004, "heatThresholdC": 38 },
      "sorghum_sudangrass": { "droughtKy": 0.8,  "heatLossPerDay": 0.003, "heatThresholdC": 38 },
      "cereal_rye":         { "droughtKy": 0.7,  "heatLossPerDay": 0.003, "heatThresholdC": 32 },
      "crimson_clover":     { "droughtKy": 0.9,  "heatLossPerDay": 0.005, "heatThresholdC": 32 },
      "hairy_vetch":        { "droughtKy": 0.9,  "heatLossPerDay": 0.005, "heatThresholdC": 32 }
    },
    "defaultCrop": { "droughtKy": 1.0, "heatLossPerDay": 0.008, "heatThresholdC": 35 },
    "stressOutlook": {
      "_note": "Fixed chance that a month is a stress month, by calendar month (Jan..Dec), with a fixed 90% range. The same for every field and every year: it says nothing about next month's real weather.",
      "monthlyChance": [0.05, 0.05, 0.08, 0.10, 0.15, 0.25, 0.35, 0.40, 0.25, 0.12, 0.06, 0.05],
      "range90": [-0.10, 0.15],
      "reasonKey": "placeholder.noOutlook"
    }
  },

  "modelC": {
    "_note": "Year types for 1985-2025: 2000 and 2011 drought, 2015 wet, everything else normal. 2040 = same mix as today (computed from these years), for both climate scenarios.",
    "firstYear": 1985,
    "lastYear": 2025,
    "types": ["drought", "hot", "wet", "normal"],
    "yearTypeOverrides": { "2000": "drought", "2011": "drought", "2015": "wet" },
    "defaultType": "normal",
    "probabilityForOverride": 1.0,
    "probabilityForDefault": 1.0,
    "frequencies2040Rule": "same-as-today"
  },

  "modelD": {
    "_note": "One fixed starting soil moisture for every field: half full (share of the soil's plant-available water).",
    "rootZoneFraction": 0.5,
    "asOf": null
  },

  "calibrationE": {
    "_note": "One fixed typical yield per crop, same for every field (rounded dryland Blackland Prairie levels). wpScale 1 = textbook water productivity; heatThresholdOffsetC 0 = textbook heat threshold. Cover crops are not sold: their typical yield is dry biomass (lb/acre).",
    "crops": {
      "winter_wheat":       { "typicalYield": 45,   "unit": "bu/acre" },
      "corn":               { "typicalYield": 85,   "unit": "bu/acre" },
      "grain_sorghum":      { "typicalYield": 60,   "unit": "bu/acre" },
      "cotton":             { "typicalYield": 600,  "unit": "lb lint/acre" },
      "soybeans":           { "typicalYield": 28,   "unit": "bu/acre" },
      "sunflower":          { "typicalYield": 1400, "unit": "lb/acre" },
      "sesame":             { "typicalYield": 600,  "unit": "lb/acre" },
      "alfalfa":            { "typicalYield": 3.5,  "unit": "tons hay/acre" },
      "cowpea":             { "typicalYield": 2000, "unit": "lb biomass/acre" },
      "sorghum_sudangrass": { "typicalYield": 4000, "unit": "lb biomass/acre" },
      "cereal_rye":         { "typicalYield": 3000, "unit": "lb biomass/acre" },
      "crimson_clover":     { "typicalYield": 2500, "unit": "lb biomass/acre" },
      "hairy_vetch":        { "typicalYield": 2500, "unit": "lb biomass/acre" }
    },
    "wpScale": 1,
    "heatThresholdOffsetC": 0
  }
}
